# ============================================================
# .env.example
# Plantilla de variables de configuración. Este archivo SÍ se
# sube a Git (no tiene contraseñas reales).
#
# Cómo usarlo: copia este archivo y renómbralo a ".env"
#   cp .env.example .env
# Luego llena los valores reales en tu copia ".env" — esa NUNCA
# se sube a Git (debe estar en el .gitignore).
# ============================================================

# --- Base de datos ---
# Formato: mysql+pymysql://[USUARIO]:[CONTRASEÑA]@localhost:3306/[NOMBRE_DE_LA_BASE]
DATABASE_URL=mysql+pymysql://perritos_app:pon_aqui_una_contraseña_real@localhost:3306/perritos_calle

# --- Almacenamiento de imágenes ---
# Ruta FUERA del proyecto/repositorio donde se guardan las fotos
# reales que suban los usuarios. Nunca debe apuntar a una carpeta
# dentro del código (ni frontend/, ni backend/static/, ni db/).
RUTA_IMAGENES=/var/data/perritos/imagenes

# --- Respaldos ---
# Carpeta donde backup.sh guarda los .sql y .tar.gz generados
RUTA_RESPALDOS=/var/backups/perritos

# --- Backend (agregado por el equipo de backend) ---
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Frontend ---
# [PENDIENTE - Frontend: agregar aquí sus propias variables, si tiene]

# ============================================================
# --- Proyecto 2: Docker (docker compose up --build) ---
# Con Docker, DATABASE_URL y RUTA_IMAGENES de arriba NO se usan:
# docker-compose.yml los arma con las variables de esta sección.
# Usa contraseñas SIN caracteres especiales (@ : / # ?) para no
# romper la cadena de conexión.
# ============================================================
DB_ROOT_PASSWORD=cambiar_root
# No cambiar: los scripts de db/ crean la base con este nombre
DB_NOMBRE=perritos_calle
# Usuario de la aplicación (backend del P1): lectura y escritura
DB_USUARIO=perritos_app
DB_PASSWORD=cambiar
# Usuario de SOLO LECTURA para el servicio Elixir
DB_LECTURA_USUARIO=perritos_lectura
DB_LECTURA_PASSWORD=cambiar_lectura
